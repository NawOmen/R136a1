  "components": [
    {
      "name": "Основная кнопка",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Рабочее подтверждаемое действие; пример не выполняет операцию.",
      "html": "<button class=\"ds-primary\" type=\"button\">Продолжить</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:11px 18px;border:1px solid transparent;border-radius:12px;font-size:14px;font-weight:650;line-height:1.4;cursor:pointer;font-family:var(--font-manrope,Manrope),\"Segoe UI\",sans-serif;transition:background 220ms ease;background:var(--primary,rgb(18 53 108));color:var(--on-primary,white)}.ds-primary:hover{background:var(--primary-hover,rgb(34 85 143))}.ds-primary:focus-visible{outline:2px solid var(--primary,rgb(18 53 108));outline-offset:4px;}.ds-primary:active{transform:translateY(1px) scale(.98)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;transform:none}}"
    },
    {
      "name": "Вторичная кнопка",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Спокойное дополнительное действие.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Повторить</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:11px 18px;border:1px solid transparent;border-radius:12px;font-size:14px;font-weight:650;line-height:1.4;cursor:pointer;font-family:var(--font-manrope,Manrope),\"Segoe UI\",sans-serif;transition:background 220ms ease;background:var(--surface-raised,rgb(248 251 254));color:var(--text,rgb(9 9 34));border-color:var(--border,rgb(219 232 243))}.ds-secondary:hover{background:var(--primary-soft,rgb(218 238 252))}.ds-secondary:focus-visible{outline:2px solid var(--primary,rgb(18 53 108));outline-offset:4px;}.ds-secondary:active{transform:translateY(1px) scale(.98)}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none;transform:none}}"
    },
    {
      "name": "Объёмное действие: статическая оболочка",
      "kind": "button",
      "refersTo": "liquid-action-primary",
      "description": "CSS fallback ключевой кнопки; реальная сетка живёт отдельно от надписи.",
      "html": "<button type=\"button\" class=\"ds-liquid\">Создать потребность<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-liquid{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:44px;padding:10px 23px;border:0;border-radius:19px;background:linear-gradient(145deg,var(--primary-hover,rgb(34 85 143)),var(--primary,rgb(18 53 108)));color:var(--on-primary,white);font-size:12px;font-weight:700;line-height:1.4;font-family:var(--font-manrope,Manrope),\"Segoe UI\",sans-serif;box-shadow:inset 0 2px 2px rgb(255 255 255 / .95),inset 0 -3px 7px rgb(74 111 145 / .18),0 14px 32px rgb(29 53 76 / .12);cursor:pointer}.ds-liquid:hover{box-shadow:0 18px 38px rgb(29 53 76 / .12)}.ds-liquid:focus-visible{outline:2px solid var(--primary,rgb(18 53 108));outline-offset:4px;}@media(forced-colors:active){.ds-liquid{background:ButtonFace;color:ButtonText;border:1px solid ButtonText;box-shadow:none}}"
    },
    {
      "name": "Контурное действие баннера",
      "kind": "button",
      "refersTo": "liquid-action-outline",
      "description": "Статическая оптическая оболочка над неизменной надписью.",
      "html": "<a class=\"ds-liquid-outline\" href=\"/needs/new\">Разместить потребность<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-liquid-outline{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:48px;padding:11px 24px;border:1px solid rgb(44 106 190);border-radius:10px;color:rgb(25 81 163);background:rgb(255 255 255 / .82);font-family:var(--font-manrope,Manrope),\"Segoe UI\",sans-serif;font-size:15px;font-weight:700;line-height:1.4;text-decoration:none;box-shadow:inset 0 2px 2px rgb(255 255 255 / .95),inset 0 -3px 7px rgb(74 111 145 / .18),0 14px 32px rgb(29 53 76 / .12)}.ds-liquid-outline:hover{box-shadow:0 18px 38px rgb(29 53 76 / .12)}.ds-liquid-outline:focus-visible{outline:2px solid var(--primary,rgb(18 53 108));outline-offset:4px}@media(forced-colors:active){.ds-liquid-outline{border-color:LinkText;color:LinkText;background:Canvas;box-shadow:none}}"
    },
    {
      "name": "Поиск",
      "kind": "input",
      "refersTo": "market-search",
      "description": "Доступная компактная форма с настоящим полем и кнопкой.",
      "html": "<form class=\"ds-search\" role=\"search\" onsubmit=\"return false\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6\"/><path d=\"m15 15 5 5\"/></svg><input aria-label=\"Найти товар\" placeholder=\"Найти товар или производителя\"><button type=\"submit\">Найти <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button></form>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;max-width:520px;height:42px;padding:2px 2px 2px 14px;border:1px solid var(--border,rgb(219 232 243));border-radius:25px;background:var(--surface-raised,rgb(248 251 254));color:var(--text-muted,rgb(83 94 115));font-family:var(--font-manrope,Manrope),\"Segoe UI\",sans-serif;}.ds-search input{width:100%;min-width:0;height:36px;padding:0;border:0;outline:0;background:transparent;color:var(--text,rgb(9 9 34));font:12px var(--font-manrope,Manrope),sans-serif}.ds-search button{display:flex;align-items:center;gap:14px;min-width:100px;height:36px;padding:0 17px;border:0;border-radius:23px;background:var(--primary,rgb(18 53 108));color:var(--on-primary,white);font:650 12px var(--font-manrope,Manrope),sans-serif;cursor:pointer}.ds-search button:hover{background:var(--primary-hover,rgb(34 85 143))}.ds-search:focus-within{box-shadow:0 0 0 3px rgb(44 116 191 / .2)}.ds-search button:focus-visible{outline:2px solid var(--primary,rgb(18 53 108));outline-offset:4px;}@media(max-width:1000px){.ds-search{height:48px}.ds-search input,.ds-search button{height:44px}}"
    },
    {
      "name": "Поле формы",
      "kind": "input",
      "refersTo": "field",
      "description": "Подпись и видимый фокус для рабочего ввода.",
      "html": "<label class=\"ds-field\">Название потребности<input type=\"text\" placeholder=\"Что нужно закупить?\"></label>",
      "css": ".ds-field{display:grid;gap:8px;color:var(--text,rgb(9 9 34));font-size:14px;font-weight:600;font-family:var(--font-manrope,Manrope),\"Segoe UI\",sans-serif;}.ds-field input{min-height:46px;padding:12px 14px;border:1px solid var(--border,rgb(219 232 243));border-radius:10px;background:var(--field-bg,white);color:var(--text,rgb(9 9 34));font:400 14px var(--font-manrope,Manrope),sans-serif}.ds-field input:hover{border-color:var(--primary,rgb(18 53 108))}.ds-field input:focus-visible{outline:none;border-color:var(--primary,rgb(18 53 108));box-shadow:0 0 0 3px rgb(44 116 191 / .2)}"
    },
    {
      "name": "Разделы рынка",
      "kind": "nav",
      "refersTo": "market-navigation",
      "description": "Два маршрута с явно выбранным текущим разделом.",
      "html": "<nav class=\"ds-lanes\" aria-label=\"Раздел рынка\"><a aria-current=\"page\" href=\"/catalog\">Товары</a><a href=\"/needs\">Потребности</a></nav>",
      "css": ".ds-lanes{display:inline-flex;gap:2px;padding:3px;border:1px solid var(--border,rgb(219 232 243));border-radius:24px;background:var(--surface,white);font-family:var(--font-manrope,Manrope),\"Segoe UI\",sans-serif;}.ds-lanes a{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:6px 12px;border-radius:20px;font-size:12px;font-weight:600;color:var(--text-muted,rgb(83 94 115));text-decoration:none}.ds-lanes a[aria-current]{background:var(--primary-soft,rgb(218 238 252));color:var(--text,rgb(9 9 34))}.ds-lanes a:hover{background:var(--bg-accent,rgb(235 244 251))}.ds-lanes a:focus-visible{outline:2px solid var(--primary,rgb(18 53 108));outline-offset:4px;}"
    },
    {
      "name": "Категория",
      "kind": "chip",
      "refersTo": "category",
      "description": "Плотная объёмная кнопка категории с фаской/тенью и aria-pressed. CSS hover scale1.025/180ms; без liquid, canvas и WebGL. Reduced motion/touch статичны.",
      "html": "<button class=\"ds-category\" type=\"button\" aria-pressed=\"true\"><svg width=\"29\" height=\"29\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"m12 3 9 5-9 5-9-5Zm-9 5v10l9 5 9-5V8M12 13v10\"/></svg>Все категории</button>",
      "css": ".ds-category{display:inline-flex;align-items:center;justify-content:center;gap:20px;min-width:150px;height:clamp(54px,4.22vw,60px);padding:10px 22px;border:1px solid var(--border,rgb(219 232 243));border-radius:9px;background:var(--surface,white);color:var(--text,rgb(9 9 34));font-size:12px;font-weight:550;font-family:var(--font-manrope,Manrope),\"Segoe UI\",sans-serif;box-shadow:inset 0 1px 0 rgb(255 255 255 / .9),0 3px 0 rgb(188 207 224 / .55),0 6px 10px rgb(29 53 76 / .07);cursor:pointer;transition:transform 180ms var(--ease-out,cubic-bezier(.22,1,.36,1)),background 180ms ease,border-color 180ms ease}.ds-category svg{color:rgb(27 88 172)}.ds-category[aria-pressed=true]{background:var(--primary-soft,rgb(218 238 252));border-color:rgb(181 212 237);font-weight:750}.ds-category:hover{border-color:rgb(145 184 221)}.ds-category:focus-visible{outline:2px solid var(--primary,rgb(18 53 108));outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-category{transition:none}}@media(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference){.ds-category:hover{transform:scale(1.025)}.ds-category:active{transform:scale(1.005);transition-duration:100ms}}"
    },
    {
      "name": "Карточка предложения",
      "kind": "card",
      "refersTo": "product-card",
      "description": "Схема карточки без выдуманного товара, цены и проверки производителя.",
      "html": "<article class=\"ds-product\"><a href=\"/catalog\"><div class=\"ds-product-visual\">Без фотографии</div><div class=\"ds-product-body\"><h3>Название из каталога</h3><div class=\"ds-product-price\">Цена из каталога <small>/ ед.</small></div><p>Условия предложения</p></div></a></article>",
      "css": ".ds-product{width:286px;padding:3px;overflow:hidden;border:1px solid var(--border,rgb(219 232 243));border-radius:9px;background:var(--surface,white);color:var(--text,rgb(9 9 34));box-shadow:0 3px 10px rgb(44 85 124 / .05);font-family:var(--font-manrope,Manrope),\"Segoe UI\",sans-serif;}.ds-product a{display:block;color:inherit;text-decoration:none;border-radius:7px}.ds-product-visual{display:flex;align-items:center;justify-content:center;aspect-ratio:1.546;border-radius:5px 5px 0 0;background:var(--bg-accent,rgb(235 244 251));color:var(--text-muted,rgb(83 94 115));font-size:11px}.ds-product-body{display:flex;flex-direction:column;gap:7px;min-height:99px;padding:9px 14px 11px}.ds-product h3{margin:0;font-size:15px;font-weight:750;line-height:1.35;letter-spacing:-.025em}.ds-product-price{font-size:23px;font-weight:800;line-height:1.2;letter-spacing:-.035em;font-variant-numeric:tabular-nums}.ds-product small{font-size:12px;font-weight:400}.ds-product p{margin:0;color:var(--text-muted,rgb(83 94 115));font-size:11px}.ds-product a:hover{text-decoration:none}.ds-product a:focus-visible{outline:2px solid var(--primary,rgb(18 53 108));outline-offset:4px;}"
    },
    {
      "name": "Избранное в браузере",
      "kind": "button",
      "refersTo": "product-card",
      "description": "Независимый переключатель; без JavaScript показано состояние выбора.",
      "html": "<button class=\"ds-favorite\" type=\"button\" aria-pressed=\"true\" aria-label=\"Убрать из избранного\" title=\"Сохраняется в этом браузере\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z\"/></svg></button>",
      "css": ".ds-favorite{position:relative;isolation:isolate;display:grid;place-items:center;width:44px;height:44px;padding:12px;border:0;background:transparent;color:var(--text,rgb(9 9 34));cursor:pointer}.ds-favorite::before{content:\"\";position:absolute;inset:8px;z-index:-1;border-radius:6px;background:var(--surface,white)}.ds-favorite[aria-pressed=true]{color:rgb(25 82 164)}.ds-favorite[aria-pressed=true] svg{fill:var(--primary-soft,rgb(218 238 252))}.ds-favorite:hover::before{background:var(--bg-accent,rgb(235 244 251))}.ds-favorite:focus-visible{outline:2px solid var(--primary,rgb(18 53 108));outline-offset:4px;outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Понятная торговая витрина",
    "overview": "Понятная торговая витрина соединяет почти белую голубоватую сцену, настоящие белые карточки, тёмные чернила и синие действия. Плотная композиция помогает сразу увидеть товар и цену; объёмная оптика остаётся локальным свойством ключевых кнопок. Исходные цвета логотипа и изображений товаров сохраняются.\n\nВизуальная власть принадлежит пользовательскому [макету](.impeccable/references/approved-storefront.png); его воспроизведение прямо запрошено пользователем. Предыдущая серебристая сцена заменена. Тёмная тема даёт полный чернильный аналог шапки, поиска, меню, карточек и форм. Контракт композиции хранится в [market.md](.impeccable/surfaces/market.md); продуктовые ограничения — в [PRODUCT.md](PRODUCT.md), с приоритетом его последней коррекции.",
    "keyCharacteristics": [
