# Auth / Gateway
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL. Порт 5433 выбран, чтобы не конфликтовать с локальным Postgres на 5432.
# Внутри Docker сервисы обращаются к postgres:5432 (см. docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://sborka:sborka@localhost:5433/sborka
POSTGRES_USER=sborka
POSTGRES_PASSWORD=sborka
POSTGRES_DB=sborka
POSTGRES_PORT=5433

# Порты сервисов
GATEWAY_AUTH_PORT=8001
MARKETPLACE_PORT=8002
WEB_PORT=3000
MINIO_PORT=9000

# Seed (синтетические демо-аккаунты, только для локальной разработки)
SEED_ADMIN_EMAIL=admin@demo.ru
SEED_ADMIN_PASSWORD=admin123
SEED_DEMO_EMAIL=demo@demo.ru
SEED_DEMO_PASSWORD=demo123
SEED_SELLER_EMAIL=seller@demo.ru
SEED_SELLER_PASSWORD=seller123

# LLM (этап 4); Ollama на хосте разработчика
OLLAMA_BASE_URL=http://localhost:11434
DEEPSEEK_API_KEY=

# Объектное хранилище MinIO (этап 3+) и события
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=sborka
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
NATS_URL=
