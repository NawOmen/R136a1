# Auth / Gateway
JWT_SECRET=
OPTIMIZER_TOKEN=
ENABLE_DEMO_SEED=false
TLS_CERT_DIR=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Письма восстановления доступа: SMTP с TLS, отдельный служебный отправитель.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# PostgreSQL. Порт 5433 выбран, чтобы не конфликтовать с локальным Postgres на 5432.
# Внутри Docker сервисы обращаются к postgres:5432 (см. docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://sborka:sborka@localhost:5433/sborka
POSTGRES_USER=sborka
POSTGRES_PASSWORD=
POSTGRES_DB=sborka
POSTGRES_PORT=5433

# pgAdmin (локальная разработка; используйте отдельный пароль вне демо)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@demo.ru
PGADMIN_DEFAULT_PASSWORD=

# Порты сервисов
GATEWAY_AUTH_PORT=8001
MARKETPLACE_PORT=8002
LLM_GATEWAY_PORT=8003
OPTIMIZER_PORT=8004
WEB_PORT=3000
MINIO_PORT=9000

# Seed (синтетические демо-аккаунты, только для локальной разработки)
SEED_ADMIN_EMAIL=admin@demo.ru
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=demo@demo.ru
SEED_DEMO_PASSWORD=
SEED_SELLER_EMAIL=seller@demo.ru
SEED_SELLER_PASSWORD=

# LLM: локальная Ollama; серверная схема с модельными ноутбуками — DEPLOYMENT.md
# Для диагностических утилит; Compose передаёт Gateway значение OLLAMA_DOCKER_BASE_URL.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
# Основная модель — локальный обученный кандидат; изображения распознаёт vision-модель.
LOCAL_LLM_BACKEND=mlx
MLX_BASE_URL=http://host.docker.internal:8080
TRAINED_MODEL_VERSION=porukam-buyer-b2cf30b11110
MLX_MAX_TOKENS=640
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_VISION_MODEL=qwen3.5:9b
LLM_CONTEXT_TOKENS=8192
LOCAL_INFERENCE_COST_RUB_PER_MINUTE=0.35
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
WHISPER_MODEL=small

# Объектное хранилище MinIO (этап 3+) и события
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=sborka
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
NATS_URL=

# Два пробных сценария buyer-agent на пользователя; ручное создание бесплатно.
BUYER_TRIAL_ENABLED=true

# Необязательно: серверные подсказки российских адресов (ДаДата)
DADATA_API_KEY=
